# ───────────────────────────────────────────────────────────────
# Variables de entorno — Portal Escuela Particular Monterrey
# Copia este archivo como .env.local (desarrollo) o configúralas en el servidor.
# NUNCA subas el archivo .env.local al repositorio.
# ───────────────────────────────────────────────────────────────

# URL pública del sitio (SEO, sitemap, Open Graph, enlaces para compartir)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OBLIGATORIO en producción. Cadena larga y aleatoria (mínimo 32 caracteres) para firmar sesiones.
#   openssl rand -base64 48
SESSION_SECRET=

# Código de instalación y recuperación de acceso del panel (guárdalo como una contraseña).
# Se pide una sola vez para crear el primer administrador en /admin/instalacion
# y sirve para recuperar el acceso si se pierden todas las contraseñas.
#   openssl rand -base64 24
SETUP_TOKEN=

# Carpeta donde se guarda la información publicada y los archivos subidos.
# En producción debe ser un disco persistente (volumen), con respaldo periódico.
DATA_DIR=./data

# ── Formulario de contacto (servicio de correo Resend: https://resend.com) ──
# Mientras estas tres variables no estén definidas, el formulario se muestra como "no habilitado".
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
